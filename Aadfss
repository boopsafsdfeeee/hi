#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
File List Explorer
==================
Opens a large text file where each line is 'absolute_path<TAB>size' (one file per
line) and lets you browse it like Windows File Explorer: a folder tree on the left
and a details list on the right.

Highlights
  - Standard library only (tkinter) -> no installation needed (Python 3.8+)
  - Input is read as UTF-8 (BOM aware) so every language renders without corruption
  - Handles tens/hundreds of MB (millions of lines) via a background thread
  - Per-extension icons (document, pdf, image, audio, video, code, archive, app),
    plus folder and generic-file icons
  - Back / Forward / Up buttons, address bar, double-click a folder to enter
  - Navigate across every drive/root (This PC lists all of them)
  - Search by file name OR extension; results from many folders are listed row by
    row with their directory path, and double-clicking a file jumps into its folder

Run
  python filelist_explorer.py               # then click Open
  python filelist_explorer.py  list.txt      # open a file directly

IMPORTANT: save the input list as UTF-8 (UTF-8 with BOM is also fine).
"""

import os
import sys
import threading
import queue
import tkinter as tk
from tkinter import ttk, filedialog, messagebox


# ============================ data model ============================

class Node:
    """Tree node. children is None for files, a dict for directories."""
    __slots__ = ('name', 'size', 'children', 'parent')

    def __init__(self, name, parent):
        self.name = name
        self.size = 0
        self.children = None
        self.parent = parent

    @property
    def is_dir(self):
        return self.children is not None


def split_path(path):
    """Split an absolute path into components (Windows / Unix / UNC).

    Uses C-level str.replace + str.split (no per-char Python loop) because this
    runs once per input line -- millions of times on large files.
    """
    p = path.strip()
    if not p:
        return []
    if p.startswith('\\\\'):                       # UNC \\server\share\...
        rest = [x for x in p[2:].replace('\\', '/').split('/') if x]
        return ['\\\\' + rest[0]] + rest[1:] if rest else ['\\\\']
    unix = p[0] == '/'                             # Unix absolute path
    parts = [x for x in p.replace('\\', '/').split('/') if x]
    return (['/'] + parts) if unix else parts


def add_path(root, parts, size):
    node = root
    for part in parts:
        if node.children is None:
            node.children = {}
        child = node.children.get(part)
        if child is None:
            child = Node(part, node)
            node.children[part] = child
        node = child
    node.size = size


def compute_dir_sizes(root):
    stack = [(root, False)]
    while stack:
        node, done = stack.pop()
        if node.children is None:
            continue
        if done:
            node.size = sum(c.size for c in node.children.values())
        else:
            stack.append((node, True))
            for c in node.children.values():
                stack.append((c, False))


def full_path(node):
    parts = []
    while node is not None and node.parent is not None:
        parts.append(node.name)
        node = node.parent
    parts.reverse()
    if not parts:
        return ''
    if parts[0] == '/':
        return '/' + '/'.join(parts[1:])
    return '\\'.join(parts)


def human_size(n):
    if n is None or n < 0:
        return ''
    units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB']
    f = float(n)
    i = 0
    while f >= 1024 and i < len(units) - 1:
        f /= 1024.0
        i += 1
    return f"{int(n):,} B" if i == 0 else f"{f:,.1f} {units[i]}"


# ---- extension -> category / label ----

EXT_CAT = {}
def _reg(cat, exts):
    for e in exts.split():
        EXT_CAT[e] = cat
_reg('pdf',   'pdf')
_reg('doc',   'txt md markdown rtf log tex hwp')
_reg('word',  'doc docx odt')
_reg('sheet', 'xls xlsx csv tsv ods')
_reg('ppt',   'ppt pptx odp key')
_reg('image', 'jpg jpeg png gif bmp webp svg tif tiff ico heic heif')
_reg('audio', 'mp3 wav flac m4a aac ogg wma opus')
_reg('video', 'mp4 mkv mov avi webm wmv flv m4v mpg mpeg')
_reg('code',  'py js ts jsx tsx java c cc cpp h hpp cs go rs rb php swift kt '
              'html htm css scss less json yaml yml xml sh bat ps1 sql')
_reg('archive', 'zip rar 7z tar gz bz2 xz iso cab tgz')
_reg('exe',   'exe msi dll sys bin app dmg deb rpm apk')

CAT_LABEL = {
    'pdf': 'PDF Document', 'doc': 'Text Document', 'word': 'Word Document',
    'sheet': 'Spreadsheet', 'ppt': 'Presentation', 'image': 'Image',
    'audio': 'Audio', 'video': 'Video', 'code': 'Source Code',
    'archive': 'Archive', 'exe': 'Application',
}

def categorize(name):
    ext = os.path.splitext(name)[1].lower().lstrip('.')
    return EXT_CAT.get(ext, 'file')

def type_label(node):
    if node.is_dir:
        return 'File folder'
    ext = os.path.splitext(node.name)[1].lower()
    cat = EXT_CAT.get(ext.lstrip('.'), 'file')
    if cat != 'file':
        return CAT_LABEL[cat]
    return (ext.lstrip('.').upper() + ' File') if ext else 'File'


# ============================ icons ============================

def _blank():
    return [[None] * 16 for _ in range(16)]

def _page(page, edge, header=None):
    g = _blank()
    for x in range(2, 14):
        g[1][x] = edge
        g[14][x] = edge
    for y in range(1, 15):
        g[y][2] = edge
        g[y][13] = edge
    for y in range(2, 14):
        for x in range(3, 13):
            g[y][x] = page
    if header:
        for y in (2, 3):
            for x in range(3, 13):
                g[y][x] = header
    return g

def _lines(g, color, rows=(7, 9, 11)):
    for y in rows:
        for x in range(4, 12):
            g[y][x] = color

def _grid(g, color):
    for y in range(6, 12):
        g[y][8] = color
    for x in range(4, 12):
        g[8][x] = color

def _image(g, sun, hill):
    for (y, x) in [(5, 5), (5, 6), (6, 5), (6, 6)]:
        g[y][x] = sun
    for (y, x) in [(11, 4), (11, 5), (11, 6), (11, 7), (11, 8), (11, 9), (11, 10), (11, 11),
                   (10, 5), (10, 6), (10, 9), (10, 10), (9, 6), (9, 7), (9, 8), (9, 9)]:
        g[y][x] = hill

def _note(g, c):
    for y in range(5, 12):
        g[y][10] = c
    for (y, x) in [(11, 8), (11, 9), (12, 8), (12, 9)]:
        g[y][x] = c
    for (y, x) in [(5, 10), (5, 11), (6, 11)]:
        g[y][x] = c

def _play(g, c):
    tri = [(5, 6), (6, 6), (7, 6), (8, 6), (9, 6), (10, 6), (11, 6),
           (6, 7), (7, 7), (8, 7), (9, 7), (10, 7),
           (7, 8), (8, 8), (9, 8), (8, 9)]
    for (y, x) in tri:
        g[y][x] = c

def _code(g, c):
    for (y, x) in [(6, 6), (7, 5), (8, 4), (9, 5), (10, 6)]:
        g[y][x] = c
    for (y, x) in [(6, 9), (7, 10), (8, 11), (9, 10), (10, 9)]:
        g[y][x] = c

def _band(g, c):
    for x in range(3, 13):
        g[8][x] = c
        g[9][x] = c
    for (y, x) in [(10, 7), (10, 8), (11, 7), (11, 8)]:
        g[y][x] = c

def _win(g, c):
    for y in range(6, 12):
        for x in range(5, 11):
            if y in (6, 11) or x in (5, 10):
                g[y][x] = c
    for x in range(5, 11):
        g[7][x] = c

FOLDER_PIXELS = [
    "                ", "   DDDD         ", "  DFFFFD        ", " DFFFFFFDDDDDDD ",
    " DFFFFFFFFFFFFD ", " DFFFFFFFFFFFFD ", " DFFFFFFFFFFFFD ", " DFFFFFFFFFFFFD ",
    " DFFFFFFFFFFFFD ", " DFFFFFFFFFFFFD ", " DFFFFFFFFFFFFD ", " DDDDDDDDDDDDDD ",
    "                ", "                ", "                ", "                ",
]
FOLDER_PAL = {'D': '#e0a020', 'F': '#ffce54'}


def _grid_to_image(g):
    img = tk.PhotoImage(width=16, height=16)
    for y in range(16):
        for x in range(16):
            c = g[y][x]
            if c:
                img.put(c, to=(x, y))
    return img

def _pixels_to_image(pixels, palette):
    img = tk.PhotoImage(width=len(pixels[0]), height=len(pixels))
    for y, row in enumerate(pixels):
        for x, ch in enumerate(row):
            c = palette.get(ch)
            if c:
                img.put(c, to=(x, y))
    return img


def build_icons():
    icons = {}
    icons['folder'] = _pixels_to_image(FOLDER_PIXELS, FOLDER_PAL)
    icons['file'] = _grid_to_image(_page('#eef3f8', '#8794a3'))

    g = _page('#ffffff', '#c0392b', header='#e04a4a'); _lines(g, '#f1c7c1'); icons['pdf'] = _grid_to_image(g)
    g = _page('#ffffff', '#5b7bb0', header='#5b8def'); _lines(g, '#c3d2ec'); icons['doc'] = _grid_to_image(g)
    g = _page('#ffffff', '#2b579a', header='#2b579a'); _lines(g, '#c3d2ec'); icons['word'] = _grid_to_image(g)
    g = _page('#ffffff', '#1d7044', header='#1d7044'); _grid(g, '#1d7044');  icons['sheet'] = _grid_to_image(g)
    g = _page('#ffffff', '#c15911', header='#d24726'); _lines(g, '#f2ceb2'); icons['ppt'] = _grid_to_image(g)
    g = _page('#eaf5ee', '#3a8f63');                  _image(g, '#ffd23f', '#3a8f63'); icons['image'] = _grid_to_image(g)
    g = _page('#efeaf7', '#7a4fb0');                  _note(g, '#7a4fb0');   icons['audio'] = _grid_to_image(g)
    g = _page('#e9ecf7', '#3f51b5');                  _play(g, '#3f51b5');   icons['video'] = _grid_to_image(g)
    g = _page('#eef1f4', '#3b4252');                  _code(g, '#4c9a8a');   icons['code'] = _grid_to_image(g)
    g = _page('#fbf1dc', '#b5842a');                  _band(g, '#b5842a');   icons['archive'] = _grid_to_image(g)
    g = _page('#eef0f2', '#5a6672');                  _win(g, '#5a6672');    icons['exe'] = _grid_to_image(g)
    return icons


# ============================ GUI ============================

class ExplorerApp:
    CAP = 20000
    SEARCH_LIMIT = 5000

    def __init__(self, root_win, start_path=None):
        self.win = root_win
        self.win.title("File List Explorer")
        self.win.geometry("1120x700")

        self.tree_root = None
        self.current = None
        self.history = []
        self.hist_idx = -1
        self.sort_key = 'name'
        self.sort_reverse = False
        self.search_active = False
        self._last_results = []

        self._q = queue.Queue()
        self._search_gen = 0
        self._syncing = False

        self.icons = build_icons()

        self.tree_nodes = {}
        self.node_to_iid = {}
        self._populated = set()
        self.list_nodes = {}

        self._build_style()
        self._build_toolbar()
        self._build_body()
        self._build_status()
        self.win.after(100, self._poll_queue)

        if start_path:
            self.load_file(start_path)

    # ---- icon lookup ----
    def icon_for(self, node):
        if node.is_dir:
            return self.icons['folder']
        return self.icons.get(categorize(node.name), self.icons['file'])

    # ---- UI ----
    def _build_style(self):
        style = ttk.Style()
        try:
            style.theme_use('clam')
        except tk.TclError:
            pass
        style.configure('Treeview', rowheight=22)

    def _build_toolbar(self):
        bar = ttk.Frame(self.win, padding=(6, 6))
        bar.pack(fill='x')
        ttk.Button(bar, text="Open", command=self.open_dialog).pack(side='left')
        ttk.Separator(bar, orient='vertical').pack(side='left', fill='y', padx=6)
        self.btn_back = ttk.Button(bar, text="\u25c0 Back", command=self.go_back, state='disabled')
        self.btn_back.pack(side='left')
        self.btn_fwd = ttk.Button(bar, text="Forward \u25b6", command=self.go_forward, state='disabled')
        self.btn_fwd.pack(side='left', padx=(4, 0))
        self.btn_up = ttk.Button(bar, text="\u25b2 Up", command=self.go_up, state='disabled')
        self.btn_up.pack(side='left', padx=(4, 0))
        ttk.Label(bar, text="  Address:").pack(side='left')
        self.addr_var = tk.StringVar()
        ttk.Entry(bar, textvariable=self.addr_var, state='readonly').pack(
            side='left', fill='x', expand=True, padx=4)

        srch = ttk.Frame(self.win, padding=(6, 0, 6, 6))
        srch.pack(fill='x')
        ttk.Label(srch, text="Search:").pack(side='left')
        self.search_var = tk.StringVar()
        ent = ttk.Entry(srch, textvariable=self.search_var, width=42)
        ent.pack(side='left', padx=4)
        ent.bind('<Return>', lambda e: self.do_search())
        ttk.Button(srch, text="Find", command=self.do_search).pack(side='left')
        ttk.Button(srch, text="Clear", command=self.clear_search).pack(side='left', padx=(4, 0))
        self.scope_var = tk.BooleanVar(value=False)
        ttk.Checkbutton(srch, text="Current folder only", variable=self.scope_var).pack(side='left', padx=8)
        ttk.Label(srch, text="(by name or extension, e.g. report or .pdf)",
                  foreground='#888').pack(side='left')

    def _build_body(self):
        pane = ttk.PanedWindow(self.win, orient='horizontal')
        pane.pack(fill='both', expand=True, padx=6, pady=(0, 4))

        left = ttk.Frame(pane)
        self.tree = ttk.Treeview(left, show='tree', selectmode='browse')
        tsb = ttk.Scrollbar(left, orient='vertical', command=self.tree.yview)
        self.tree.configure(yscrollcommand=tsb.set)
        self.tree.pack(side='left', fill='both', expand=True)
        tsb.pack(side='right', fill='y')
        self.tree.bind('<<TreeviewOpen>>', self._on_tree_open)
        self.tree.bind('<<TreeviewSelect>>', self._on_tree_select)
        pane.add(left, weight=1)

        right = ttk.Frame(pane)
        cols = ('type', 'size', 'path')
        self.list = ttk.Treeview(right, columns=cols, show='tree headings', selectmode='browse')
        self.list.heading('#0', text='Name', command=lambda: self._sort_by('name'))
        self.list.heading('type', text='Type', command=lambda: self._sort_by('type'))
        self.list.heading('size', text='Size', command=lambda: self._sort_by('size'))
        self.list.heading('path', text='Path')
        self.list.column('#0', width=360, anchor='w')
        self.list.column('type', width=150, anchor='w')
        self.list.column('size', width=120, anchor='e')
        self.list.column('path', width=420, anchor='w')
        self.list['displaycolumns'] = ('type', 'size')
        lsb = ttk.Scrollbar(right, orient='vertical', command=self.list.yview)
        self.list.configure(yscrollcommand=lsb.set)
        self.list.pack(side='left', fill='both', expand=True)
        lsb.pack(side='right', fill='y')
        self.list.bind('<Double-1>', self._on_list_activate)
        self.list.bind('<Return>', self._on_list_activate)
        pane.add(right, weight=3)

    def _build_status(self):
        self.status_var = tk.StringVar(value="Open a file to begin.  (path<TAB>size, UTF-8)")
        ttk.Label(self.win, textvariable=self.status_var, relief='sunken',
                  anchor='w', padding=(6, 2)).pack(fill='x')

    # ---- loading (UTF-8) ----
    def open_dialog(self):
        path = filedialog.askopenfilename(
            title="Open file list (UTF-8 text)",
            filetypes=[("Text files", "*.txt *.tsv *.log *.lst"), ("All files", "*.*")])
        if path:
            self.load_file(path)

    def load_file(self, path):
        if not os.path.isfile(path):
            messagebox.showerror("Error", f"File not found:\n{path}")
            return
        self.status_var.set(f"Loading... 0 lines  ({os.path.basename(path)})")
        self._reset_views()
        threading.Thread(target=self._load_worker, args=(path,), daemon=True).start()

    def _load_worker(self, path):
        root = Node('', None)
        root.children = {}
        files = 0
        try:
            # UTF-8 with BOM support; errors='replace' guarantees no crash while
            # every valid UTF-8 byte sequence (any language) decodes correctly.
            _split = split_path          # local aliases avoid attribute lookups
            _add = add_path
            _put = self._q.put
            with open(path, 'r', encoding='utf-8-sig', errors='replace', newline='') as f:
                for line in f:
                    line = line.rstrip('\r\n')
                    if not line:
                        continue
                    tab = line.rfind('\t')
                    if tab == -1:
                        p, size = line, 0
                    else:
                        p = line[:line.find('\t')]     # path = first field
                        c = line[tab + 1:].strip()      # size = last field
                        if ',' in c:
                            c = c.replace(',', '')
                        size = int(c) if c.isdigit() else 0
                    parts = _split(p)
                    if not parts:
                        continue
                    _add(root, parts, size)
                    files += 1
                    if files % 50000 == 0:
                        _put(('progress', files))
        except Exception as e:  # noqa
            self._q.put(('error', str(e)))
            return
        compute_dir_sizes(root)
        self._q.put(('done', (root, files)))

    def _poll_queue(self):
        try:
            while True:
                kind, payload = self._q.get_nowait()
                if kind == 'progress':
                    self.status_var.set(f"Loading... {payload:,} lines")
                elif kind == 'error':
                    messagebox.showerror("Read error", payload)
                    self.status_var.set("Read error")
                elif kind == 'done':
                    self._on_loaded(*payload)
                elif kind == 'search':
                    self._on_search_done(*payload)
        except queue.Empty:
            pass
        self.win.after(100, self._poll_queue)

    def _on_loaded(self, root, files):
        self.tree_root = root
        self.history = []
        self.hist_idx = -1
        for name in sorted(root.children.keys(), key=str.lower):
            self._insert_tree_node('', root.children[name])
        self.status_var.set(f"Loaded \u00b7 {files:,} files \u00b7 UTF-8 \u00b7 "
                            f"{len(root.children):,} drive(s)/root(s)")
        self.show_dir(root)

    def _reset_views(self):
        self.tree.delete(*self.tree.get_children())
        self.list.delete(*self.list.get_children())
        self.tree_nodes.clear()
        self.node_to_iid.clear()
        self._populated.clear()
        self.list_nodes.clear()
        self.addr_var.set('')

    # ---- left tree ----
    def _insert_tree_node(self, parent_iid, node):
        iid = self.tree.insert(parent_iid, 'end', text=' ' + node.name,
                               image=self.icons['folder'], open=False)
        self.tree_nodes[iid] = node
        self.node_to_iid[node] = iid
        if any(c.is_dir for c in node.children.values()):
            self.tree.insert(iid, 'end', text='...')
        return iid

    def _populate_tree_children(self, iid, node):
        if iid in self._populated:
            return
        self._populated.add(iid)
        for ch in self.tree.get_children(iid):
            self.tree.delete(ch)
        subdirs = [c for c in node.children.values() if c.is_dir]
        subdirs.sort(key=lambda n: n.name.lower())
        for c in subdirs:
            self._insert_tree_node(iid, c)

    def _on_tree_open(self, _e):
        iid = self.tree.focus()
        node = self.tree_nodes.get(iid)
        if node:
            self._populate_tree_children(iid, node)

    def _on_tree_select(self, _e):
        if self._syncing:
            return
        iid = self.tree.focus()
        node = self.tree_nodes.get(iid)
        if node:
            self.show_dir(node)

    def _reveal_in_tree(self, node):
        chain = []
        n = node
        while n is not None and n.parent is not None:
            chain.append(n)
            n = n.parent
        chain.reverse()
        parent_iid = ''
        for nd in chain:
            iid = self.node_to_iid.get(nd)
            if iid is None:
                if parent_iid == '':
                    return
                self._populate_tree_children(parent_iid, self.tree_nodes[parent_iid])
                iid = self.node_to_iid.get(nd)
                if iid is None:
                    return
            self.tree.item(iid, open=True)
            self._populate_tree_children(iid, nd)
            parent_iid = iid
        if parent_iid:
            self._syncing = True
            try:
                self.tree.selection_set(parent_iid)
                self.tree.see(parent_iid)
            finally:
                self._syncing = False

    # ---- right list ----
    def show_dir(self, node, add_history=True):
        if node is None or node.children is None:
            return
        self.search_active = False
        self.list['displaycolumns'] = ('type', 'size')
        if add_history:
            del self.history[self.hist_idx + 1:]
            self.history.append(node)
            self.hist_idx = len(self.history) - 1
        self.current = node
        self.addr_var.set(full_path(node) or 'This PC')
        self._populate_list(node)
        self._reveal_in_tree(node)
        self._update_nav()

    def _sort_nodes(self, nodes):
        def sk(n):
            if self.sort_key == 'size':
                return n.size
            if self.sort_key == 'type':
                return '' if n.is_dir else os.path.splitext(n.name)[1].lower()
            return n.name.lower()
        s = sorted(nodes, key=sk, reverse=self.sort_reverse)
        return s

    def _populate_list(self, node):
        self.list.delete(*self.list.get_children())
        self.list_nodes.clear()
        dirs = [c for c in node.children.values() if c.is_dir]
        files = [c for c in node.children.values() if not c.is_dir]
        dirs = self._sort_nodes(dirs)
        files = self._sort_nodes(files)
        shown = 0
        for c in dirs + files:
            if shown >= self.CAP:
                break
            self._insert_list_row(c)
            shown += 1
        total = len(dirs) + len(files)
        extra = f"  (showing {shown:,}/{total:,})" if total > shown else ""
        self.status_var.set(f"Folders {len(dirs):,} \u00b7 Files {len(files):,}{extra}")

    def _insert_list_row(self, node, show_path=False):
        pth = full_path(node.parent) if show_path else ''
        iid = self.list.insert('', 'end', text=' ' + node.name,
                               image=self.icon_for(node),
                               values=(type_label(node), human_size(node.size), pth))
        self.list_nodes[iid] = node

    def _on_list_activate(self, _e):
        iid = self.list.focus()
        node = self.list_nodes.get(iid)
        if not node:
            return
        if node.is_dir:
            self.show_dir(node)
        elif node.parent is not None:
            # a file (incl. a search result in another directory) -> open its folder
            self.show_dir(node.parent)
            self._select_in_list(node)

    def _select_in_list(self, node):
        for iid, n in self.list_nodes.items():
            if n is node:
                self.list.selection_set(iid)
                self.list.focus(iid)
                self.list.see(iid)
                break

    # ---- navigation ----
    def go_back(self):
        if self.hist_idx > 0:
            self.hist_idx -= 1
            self.show_dir(self.history[self.hist_idx], add_history=False)

    def go_forward(self):
        if self.hist_idx < len(self.history) - 1:
            self.hist_idx += 1
            self.show_dir(self.history[self.hist_idx], add_history=False)

    def go_up(self):
        if self.current and self.current.parent is not None:
            self.show_dir(self.current.parent)

    def _update_nav(self):
        self.btn_back.config(state='normal' if self.hist_idx > 0 else 'disabled')
        self.btn_fwd.config(state='normal' if self.hist_idx < len(self.history) - 1 else 'disabled')
        self.btn_up.config(state='normal' if (self.current and self.current.parent is not None) else 'disabled')

    def _sort_by(self, key):
        if self.sort_key == key:
            self.sort_reverse = not self.sort_reverse
        else:
            self.sort_key, self.sort_reverse = key, False
        if self.search_active:
            self._render_search(self._last_results)
        elif self.current:
            self._populate_list(self.current)

    # ---- search (name or extension, across all drives by default) ----
    def do_search(self):
        if self.tree_root is None:
            return
        term = self.search_var.get().strip()
        if not term:
            return
        self._search_gen += 1
        gen = self._search_gen
        scope = self.current if (self.scope_var.get() and self.current) else self.tree_root
        self.status_var.set("Searching...")
        threading.Thread(target=self._search_worker, args=(scope, term, gen), daemon=True).start()

    def _search_worker(self, scope, term, gen):
        tl = term.lower()
        results = []
        truncated = False
        limit = self.SEARCH_LIMIT
        stack = [scope]
        append = results.append
        checked = 0
        while stack:
            node = stack.pop()
            # substring match on the name covers both names and extensions
            if node.parent is not None and tl in node.name.lower():
                append(node)
                if len(results) >= limit:
                    truncated = True
                    break
            ch = node.children
            if ch:
                stack.extend(ch.values())
            # cooperative cancel: a newer search supersedes this one
            checked += 1
            if checked & 0x3FFF == 0 and gen != self._search_gen:
                return
        self._q.put(('search', (gen, term, results, truncated)))

    def _on_search_done(self, gen, term, results, truncated):
        if gen != self._search_gen:
            return
        self.search_active = True
        self._last_results = results
        self.list['displaycolumns'] = ('type', 'size', 'path')
        self._render_search(results)
        note = " (too many, showing first results)" if truncated else ""
        self.status_var.set(f"Search '{term}' \u00b7 {len(results):,} result(s){note}")

    def _render_search(self, results):
        self.list.delete(*self.list.get_children())
        self.list_nodes.clear()
        # group visually by directory: sort by (parent path, name)
        if self.sort_key in ('size', 'type'):
            ordered = self._sort_nodes(results)
        else:
            ordered = sorted(results, key=lambda n: (full_path(n.parent).lower(), n.name.lower()),
                             reverse=self.sort_reverse)
        for c in ordered[:self.CAP]:
            self._insert_list_row(c, show_path=True)

    def clear_search(self):
        self.search_var.set('')
        self.search_active = False
        self.list['displaycolumns'] = ('type', 'size')
        if self.current:
            self._populate_list(self.current)


def main():
    start = sys.argv[1] if len(sys.argv) > 1 else None
    root = tk.Tk()
    ExplorerApp(root, start)
    root.mainloop()


if __name__ == '__main__':
    main()
